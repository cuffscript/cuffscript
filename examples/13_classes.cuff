note: Classes: fields, methods, a constructor, private state and objects as values.

class Player do:
    set str name to "unknown"
    set number x to 0
    set list items to []
    private set number steps to 0

    func init(str name, number x to 0) do:
        change self.name to name
        change self.x to x
    end

    func sayhello() do:
        print(f"Hello, I am {self.name}")
    end

    func turnleft() do:
        change self.steps to self.steps + 1
    end

    func walk(number distance) do:
        change self.x to self.x + distance
        change self.steps to self.steps + 1
    end

    func pick(item) do:
        add item to self.items
    end

    func report() do:
        return f"{self.name} is at {self.x} after {self.steps} step(s), carrying {self.items}"
    end

    func to_str() do:
        return f"Player({self.name})"
    end
end

set Player player1 to Player("Ann")
player1.sayhello()
player1.walk(3)
player1.turnleft()
player1.pick("lamp")
print(player1.report())

note: each object has its own fields
set Player player2 to Player("Bob", 10)
player2.pick("map")
print(player1.items, player2.items)

note: objects are shared, not copied, when you assign them
set Player alias to player1
alias.walk(2)
print(player1.x, player1 is alias, player1 is player2)
set Player twin to player1.copy()
twin.walk(100)
print(player1.x, twin.x)

note: print and f-strings use to_str, and the class name is a type
print(player1)
print(f"{player2} is a {type_of(player2)}")
func describe(Player p) do:
    return p.name + " at " + to_str(p.x)
end
print(describe(player2))

note: a name that the class does not declare is an error, which or_else can catch
print(player1.nickname) or_else as err do:
    print(err.code)
    print(err.message)
end
