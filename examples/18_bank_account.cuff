note: An account that refuses what it cannot do by raising errors, including an error class of its own.
use DLC:list

class InsufficientFunds extends Error do:
    number shortfall = 0
end

class Account do:
    str owner = ""
    number balance = 0
    private list history = []

    func init(str owner, number opening = 0) do:
        self.owner = owner
        self.balance = opening
    end

    func deposit(number amount) do:
        if amount <= 0 do:
            fail "a deposit must be more than zero"
        end
        self.balance = self.balance + amount
        self.record("deposit", amount)
    end

    func withdraw(number amount) do:
        if amount > self.balance do:
            InsufficientFunds problem = InsufficientFunds(f"cannot withdraw {amount} from {self.balance}")
            problem.shortfall = amount - self.balance
            fail problem
        end
        self.balance = self.balance - amount
        self.record("withdraw", amount)
    end

    func statement() do:
        return list_join(self.history, "; ")
    end

    private func record(str kind, number amount) do:
        add f"{kind} {amount}" to self.history
    end
end

Account account = Account("Ann", 100)
account.deposit(50)
account.withdraw(30)

account.withdraw(500) or_else as Error err do:
    print(err.message)
    if err isa InsufficientFunds do:
        print("short by", err.shortfall)
    end
end

account.deposit(-5) or_else as Error err do:
    print(err.code, err.message)
end

account.record("tamper", 1) or_else as Error err do:
    print(err.code)
end

print(account.balance)
print(account.statement())
