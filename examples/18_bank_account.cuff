note: An account that refuses what it cannot do by raising errors, including an error class of its own.
use DLC:list

class InsufficientFunds extends Error do:
    set number shortfall to 0
end

class Account do:
    set str owner to ""
    set number balance to 0
    private set list history to []

    func init(str owner, number opening to 0) do:
        change self.owner to owner
        change self.balance to opening
    end

    func deposit(number amount) do:
        if amount <= 0 do:
            fail "a deposit must be more than zero"
        end
        change self.balance to self.balance + amount
        self.record("deposit", amount)
    end

    func withdraw(number amount) do:
        if amount > self.balance do:
            set InsufficientFunds problem to InsufficientFunds(f"cannot withdraw {amount} from {self.balance}")
            change problem.shortfall to amount - self.balance
            fail problem
        end
        change self.balance to self.balance - amount
        self.record("withdraw", amount)
    end

    func statement() do:
        return list_join(self.history, "; ")
    end

    private func record(str kind, number amount) do:
        add f"{kind} {amount}" to self.history
    end
end

set Account account to Account("Ann", 100)
account.deposit(50)
account.withdraw(30)

account.withdraw(500) or_else as err do:
    print(err.message)
    if err isa InsufficientFunds do:
        print("short by", err.shortfall)
    end
end

account.deposit(-5) or_else as err do:
    print(err.code, err.message)
end

account.record("tamper", 1) or_else as err do:
    print(err.code)
end

print(account.balance)
print(account.statement())
