note: Pattern-matching commands from docs/reference/patterns.md, all wired to a real matcher.

set str log_line to "2026-03-31 [ERROR] 192.168.0.1 - DB Connection Lost"
set match parsed to match(log_line, p"<date:[num]4-[num]2-[num]2> \[[one:INFO|WARN|ERROR]\] <ip:[num]1~3\.[num]1~3\.[num]1~3\.[num]1~3> - <msg:[any]+>")

if parsed is not empty do:
    print(f"date={parsed['date']}")
    print(f"ip={parsed['ip']}")
    print(f"msg={parsed['msg']}")
end

set str article to "Tickets T-101 T-202 T-303 are booked"
set list codes to find_all(article, p"T-[num]3")
print(codes)

set str phone_log to "call me at 010-1234-5678 today"
set str masked to replace(phone_log, p"[num]4-[num]4", "****-****")
print(masked)

set list parts to split("apple, banana,cherry", p",[sp]*")
print(parts)

print(count(article, p"[num]+"))

note: the i flag makes a pattern case-insensitive
set str answer to "YES"
if answer matches p"yes"i do:
    print("the i flag ignores case")
end

note: the [one:...] alternative token and an escaped dot (\.)
if "photo.jpg" matches p"[str]+\.[one:jpg|png|gif]" do:
    print("Image filename pattern matched")
end
