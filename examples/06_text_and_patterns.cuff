note: Pattern-matching commands from docs/reference/patterns.md, all wired to a real matcher.

str log_line = "2026-03-31 [ERROR] 192.168.0.1 - DB Connection Lost"
match parsed = match(log_line, p"<date:[num]4-[num]2-[num]2> \[[one:INFO|WARN|ERROR]\] <ip:[num]1~3\.[num]1~3\.[num]1~3\.[num]1~3> - <msg:[any]+>")

if parsed is not empty do:
    print(f"date={parsed['date']}")
    print(f"ip={parsed['ip']}")
    print(f"msg={parsed['msg']}")
end

str article = "Tickets T-101 T-202 T-303 are booked"
list codes = find_all(article, p"T-[num]3")
print(codes)

str phone_log = "call me at 010-1234-5678 today"
str masked = replace(phone_log, p"[num]4-[num]4", "****-****")
print(masked)

list parts = split("apple, banana,cherry", p",[sp]*")
print(parts)

print(count(article, p"[num]+"))

note: the i flag makes a pattern case-insensitive
str answer = "YES"
if answer matches p"yes"i do:
    print("the i flag ignores case")
end

note: the [one:...] alternative token and an escaped dot (\.)
if "photo.jpg" matches p"[str]+\.[one:jpg|png|gif]" do:
    print("Image filename pattern matched")
end

note: Patterns work per character, so Hangul counts one by one, and can be written inside a pattern.
str hangul = "안녕하세요"
if hangul matches p"[any]5" do:
    print("[any]5 matched five Hangul characters")
end
match who = match("이름: 홍길동", p"이름: <name:[any]+>")
print(f"captured name: {who['name']}")
note: [let], [str] and [word] mean English letters only.
if !(hangul matches p"[let]+") do:
    print("[let] does not match Hangul")
end
