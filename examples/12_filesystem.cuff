note: DLC:filesystem -- read and write files inside the script's folder.
note: this example creates a temporary file and deletes it at the end, so it is safe to rerun.

use DLC:filesystem

set str path to "_example_notes.txt"

print(file_exist(path))
print(file_write(path, "첫째 줄\n둘째 줄"))
print(file_add(path, "\n셋째 줄"))

print(file_size(path))
print(file_readlines(path))

note: a missing file gives empty/false rather than an error
print(file_read("_no_such_file.txt"))

print(file_remove(path))
print(file_exist(path))
