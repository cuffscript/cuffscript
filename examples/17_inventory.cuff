note: A small shop inventory: two classes that work together, and the result written as JSON.
use DLC:json

class Item do:
    str name = ""
    number price = 0
    number quantity = 0

    func init(str name, number price, number quantity = 1) do:
        self.name = name
        self.price = price
        self.quantity = quantity
    end

    func total() do:
        return self.price * self.quantity
    end

    func to_str() do:
        return f"{self.quantity} x {self.name} at {self.price}"
    end
end

class Inventory do:
    list items = []

    func add_item(Item item) do:
        add item to self.items
    end

    func total_value() do:
        number sum = 0
        loop each Item item in self.items do:
            sum = sum + item.total()
        end
        return sum
    end

    func find_item(str name) do:
        loop each Item item in self.items do:
            if item.name is name do:
                return item
            end
        end
        return empty
    end
end

Inventory shop = Inventory()
shop.add_item(Item("apple", 3, 10))
shop.add_item(Item("pear", 4, 5))
shop.add_item(Item("melon", 12))
print(shop.total_value())

Item apples = shop.find_item("apple")
print(apples)
apples.quantity = apples.quantity - 4
print(apples, shop.total_value())

if shop.find_item("kiwi") is empty do:
    print("no kiwi in stock")
end

print(to_json(shop))
