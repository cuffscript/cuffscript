note: The libraries (DLC): math, string, random, list, map, convert and json.
use DLC:math, DLC:string, DLC:random
use DLC:list
use DLC:map
use DLC:convert
use DLC:json

print(math_sqrt(16), math_abs(-5), math_max(3, 7, 2))
print(str_upper("hello"), str_trim("  padded  "))
print(contains("hello world", "world"))

note: Random numbers: with a seed the same program gives the same numbers on one machine.
random_seed(7)
set number roll to random_int(1, 6)
print(roll >= 1 and roll <= 6)

note: List functions return new lists and leave the original alone.
set list scores to [5, 2, 8, 1, 9, 2]
print(list_sort(scores))
print(list_reverse(scores))
print(list_unique(scores))
print(scores)
print(list_join(["a", "b", "c"], ", "))

note: Map functions.
set map ages to {"ann": 31, "bob": 27}
print(map_keys(ages), map_values(ages), map_has_key(ages, "bob"))

note: Conversion between types.
print(to_number("42.5") + 1, to_str(123) + "!", to_boolean(""))

note: JSON text and back.
set map config to {"name": "홍길동", "level": 42, "tags": ["a", "b"]}
print(to_json(config))
print(to_json(config, 2))
set map loaded to from_json("{\"x\": 1, \"items\": [10, 20]}")
print(loaded["items"][2])
