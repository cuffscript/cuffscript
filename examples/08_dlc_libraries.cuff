note: using the built-in DLC libraries

note: libraries can be loaded on one comma-separated line or on separate lines (same result)
use DLC:math, DLC:string, DLC:random
use DLC:list
use DLC:convert

print(math_sqrt(16))
print(math_abs(-5))
print(math_max(3, 7, 2))
print(str_upper("hello"))
print(str_trim("  padded  "))
print(contains("hello world", "world"))

set number roll to random_int(1, 6)
print(f"Dice: {roll} (should be between 1 and 6)")

note: DLC:list -- functional style: returns a new list without changing the original
set list scores to [5, 2, 8, 1, 9, 2]
print(list_sort(scores))
print(list_reverse(scores))
print(list_unique(scores))

note: list_join() only accepts lists of strings, so convert a number list with to_str() first
set list score_strs to []
loop repeat i to 1 ~ 5 do:
    add to_str(scores[i]) to score_strs
end
print(list_join(score_strs, ", "))

note: DLC:convert -- explicit type conversion
set number n to to_number("42.5")
print(n + 1)
print(to_str(123) + "!")
print(to_boolean(""))

note: DLC:json -- map/list to a JSON string, or the reverse
use DLC:json
set map config to {"name": "홍길동", "level": 42, "tags": ["a", "b"]}
print(to_json(config))
print(to_json(config, 2))

set map loaded to from_json("{\"x\": 1, \"items\": [10, 20]}")
print(loaded["items"][2])
