note: Read log lines with a pattern, count them by level and by user, and skip lines that do not fit.
use DLC:list
use DLC:map

list lines = [
    "2026-11-02 09:15:01 INFO  user=ann action=login",
    "2026-11-02 09:15:44 WARN  user=bob action=retry",
    "this line is not a log entry",
    "2026-11-02 09:16:02 INFO  user=bob action=login",
    "2026-11-02 09:17:30 ERROR user=ann action=upload",
    "2026-11-02 09:18:12 INFO  user=ann action=logout"
]

pattern entry = p"<date:[num]4-[num]2-[num]2> <time:[num]2:[num]2:[num]2> <level:[up]+> +user=<user:[word]+> action=<action:[word]+>"

map by_level = {}
map by_user = {}
number skipped = 0

loop each str line in lines do:
    any found = match(line, entry)
    if found is empty do:
        skipped = skipped + 1
        skip
    end
    str level = found["level"]
    str user = found["user"]
    if !map_has_key(by_level, level) do:
        by_level[level] = 0
    end
    if !map_has_key(by_user, user) do:
        by_user[user] = 0
    end
    by_level[level] = by_level[level] + 1
    by_user[user] = by_user[user] + 1
end

print("by level:")
loop each str level in list_sort(map_keys(by_level)) do:
    print(f"  {level}: {by_level[level]}")
end
print("by user:")
loop each str user in list_sort(map_keys(by_user)) do:
    print(f"  {user}: {by_user[user]}")
end
print(f"skipped {skipped} line(s)")
