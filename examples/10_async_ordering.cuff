note: an async function called without await is queued instead of running immediately,
note: and runs in FIFO order after all the synchronous top-level code has finished.
note: with await it runs immediately, as usual, and returns its value.

set async func notify_a() do:
    print("[async] A done")
end

set async func notify_b() do:
    print("[async] B done")
end

set async returnable func fetch_score() do:
    print("[async] looking up the score...")
    return 87
end

print("[sync] program start")

note: called without await -> not run now, queued instead
notify_a()
notify_b()

note: with await it runs immediately and the value comes back right away
set number score to await fetch_score()
print(f"[sync] score = {score}")

print("[sync] end of the program's synchronous part")
note: after this point the queued notify_a() and notify_b() run in order.
