use DLC:string

set str greeting to "안녕하세요"
print(f"1st character: {greeting[1]}")
print(f"2nd-3rd characters: {greeting[2~3]}")
print(f"last character: {greeting[-1]}")
print(f"character count: {length(greeting)}")

set str mixed to "Hi안녕!"
print(f"3rd character of the mixed string: {mixed[3]}")
print(f"mixed string character count: {length(mixed)}")

note: regex also works per code point (character)
if greeting is "[any]5" do:
    print("[any]5 matched five Hangul characters")
end

note: Hangul can be written directly inside a pattern
set match m to match "이름: 홍길동" from "이름: <name:[any]+>"
print(f"captured name: {m['name']}")

note: but [let]/[str]/[word] are English-only, per the spec
if !(greeting is "[let]+") do:
    print("[let] is English-only, so it does not match Hangul (intended)")
end
