note: regression test -- when a real local with the same name as a name bridged by
note: `change name to global` (a loop variable, an or_else recovery placeholder, ...) is used
note: in the same call, the local must always win over the bridge. The old
note: implementation checked globalDeclared_ before findLocal in Environment::resolve(),
note: so reading a loop variable named like a bridged name only ever showed the global
note: value on every iteration.

set number i to 100

set func loop_var_shadow() do:
    change i to global
    loop repeat i to 1 ~ 3 do:
        print(f"loop i = {i}")
    end
    print(f"after loop, local i = {i}")
end

loop_var_shadow()
print(f"global i untouched = {i}")

note: the or_else declaration-recovery placeholder must also shadow a bridge of the same name
set number counter to 0

set func or_else_shadow() do:
    change counter to global
    set number counter to 1 / 0 or_else do:
        set number counter to 999
        print(f"inside fallback, local counter = {counter}")
    end
    print(f"after or_else, function-scope counter = {counter}")
end

or_else_shadow()
print(f"global counter untouched = {counter}")
