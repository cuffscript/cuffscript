use DLC:list
constant list PRIMES = [2, 3, 5, 7]
print(PRIMES)
print(length(PRIMES))

note: freezing from an existing variable copies it — the source stays mutable
list mutable_src = [1, 2, 3]
constant list SNAPSHOT = mutable_src
add 99 to mutable_src
print(mutable_src)
print(SNAPSHOT)

note: shallow immutability, like a Python tuple: nested containers still mutate
constant list NESTED = [1, [2, 3]]
NESTED[2][1] = 999
print(NESTED)

note: the escape hatch — concatenation returns a fresh, mutable list
list copy = PRIMES + []
add 11 to copy
print(copy)
print(PRIMES)
