note: assignment, add and remove take a place: a name, then [index] and .field steps.
class Team do:
    list members = []
    map scores = {}
    list grid = [[1], [2, 3]]
end

list grid = [[1], [2, 3], []]
add 9 to grid[1]
add 7 to grid[3]
remove at 2 from grid[2]
print(grid)
grid[2][1] = 20
grid[1] = [0]
print(grid)

map data = {"nums": [1, 2], "inner": {"k": 1}}
add 3 to data["nums"]
data["inner"]["k"] = 5
data["inner"]["new"] = "x"
remove "new" from data["inner"]
print(data)

Team team = Team()
add "Ann" to team.members
add "Bob" to team.members
team.scores["Ann"] = 10
team.scores["Bob"] = 7
add 4 to team.grid[2]
team.grid[1][1] = 100
remove "Ann" from team.members
print(team.members, team.scores, team.grid)

number total = 0
list log = []
func bump(number by) do:
    global total, log
    total = total + by
    add by to log
end
bump(2)
bump(5)
print(total, log)

func read_total() do:
    global total
    return total
end
print(read_total())
