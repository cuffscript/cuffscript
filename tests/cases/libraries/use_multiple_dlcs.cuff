note: load several libraries on one line separated by commas -- must equal writing them on separate lines.
use DLC:math, DLC:string, DLC:convert
print(math_sqrt(16))
print(str_upper("hi"))
print(to_number("42"))

note: loading them in several mixed batches also works
use DLC:list
use DLC:map, DLC:json
print(list_sum([1, 2, 3]))
print(to_json(map_keys({"a": 1})))

note: one library per line still works (a module-load command is one use statement per line)
use DLC:time
use DLC:random
print(type_of(time_now()))
print(random_int(2, 2))
