use DLC:string

print(str_upper("hello World"))
print(str_lower("HELLO World"))

note: case mapping covers Latin, Greek and Cyrillic; other scripts pass through
print(str_upper("café ÿ straße"))
print(str_lower("ÀÉÎ ΑΒΓ ДЖЯ"))
print(str_upper("안녕 abc"))

print(str_trim_start("  hi  ") + "|")
print(str_trim_end("  hi  ") + "|")
print(str_trim("  hi  ") + "|")

print(index_of("hello world", "o"))
print(index_of("안녕하세요", "하"))
print(index_of("abc", "z"))

print(str_repeat("ab", 3))
print(str_repeat("x", 0) + "|")
print(str_pad_left("7", 3, "0"))
print(str_pad_right("ab", 5, "*") + "|")
print(str_pad_left("abc", 2))
print(str_pad_left("한", 3, "-"))

print(str_char_code("A"))
print(str_char_code("한"))
print(str_from_char_code(72) + str_from_char_code(105))
print(str_from_char_code(54620))

print(contains("hello", "ell"))
print(contains([1, 2, 3], 2))
print(contains([1, 2, 3], 9))
print(contains({"a": 1}, "a"))
print(contains({"a": 1}, "b"))
print(index_of([10, 20, 30], 20))
print(length("한글abc"))
print(length([1, 2, 3]))
