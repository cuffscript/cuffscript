use DLC:filesystem

note: like dlc_filesystem.cuff this works in whatever folder it runs in, and removes everything it makes.

file_write("_dlc_fs_plain.txt", "plain")
print(file_isdir("."), file_isdir("_dlc_fs_folders"), file_isdir("_dlc_fs_plain.txt"))

note: makedir makes the missing folders on the way, and is true for one that is already there
print(file_makedir("_dlc_fs_folders/inner/deep"))
print(file_makedir("_dlc_fs_folders/inner/deep"))
print(file_isdir("_dlc_fs_folders"), file_isdir("_dlc_fs_folders/inner/deep"))
print(file_makedir("_dlc_fs_plain.txt"))

note: list gives names only, in byte order, folders and files alike
file_write("_dlc_fs_folders/b.txt", "bee")
file_write("_dlc_fs_folders/B.txt", "BEE")
file_write("_dlc_fs_folders/ä.txt", "umlaut")
print(file_list("_dlc_fs_folders"))
print(file_list("_dlc_fs_folders/inner/deep"))
print(file_list("_dlc_fs_folders/b.txt"), file_list("_dlc_fs_never_made"))

note: copy never overwrites, and only copies a file
print(file_copy("_dlc_fs_folders/b.txt", "_dlc_fs_folders/inner/copy.txt"), file_read("_dlc_fs_folders/inner/copy.txt"))
print(file_copy("_dlc_fs_folders/b.txt", "_dlc_fs_folders/inner/copy.txt"))
print(file_copy("_dlc_fs_folders/inner", "_dlc_fs_folders/inner2"), file_copy("_dlc_fs_never_made", "_dlc_fs_folders/x"))
print(file_copy("_dlc_fs_folders/b.txt", "_dlc_fs_no_such_folder/x.txt"))

note: move renames a file or a folder, and does not replace what is there
print(file_move("_dlc_fs_folders/B.txt", "_dlc_fs_folders/inner/moved.txt"), file_exist("_dlc_fs_folders/B.txt"))
print(file_move("_dlc_fs_folders/b.txt", "_dlc_fs_folders/ä.txt"), file_read("_dlc_fs_folders/ä.txt"))
print(file_move("_dlc_fs_folders/inner", "_dlc_fs_folders/outer"), file_isdir("_dlc_fs_folders/outer/deep"))
print(file_move("_dlc_fs_never_made", "_dlc_fs_folders/x"), file_move(".", "_dlc_fs_moved_root"))
print(file_list("_dlc_fs_folders/outer"))

note: removedir takes an empty folder only; file_remove still never takes a folder
print(file_removedir("_dlc_fs_folders/outer"), file_remove("_dlc_fs_folders/outer"))
print(file_removedir("_dlc_fs_folders/b.txt"), file_removedir("_dlc_fs_never_made"), file_removedir("."))
print(file_remove("_dlc_fs_folders/outer/copy.txt"), file_remove("_dlc_fs_folders/outer/moved.txt"))
print(file_removedir("_dlc_fs_folders/outer/deep"), file_removedir("_dlc_fs_folders/outer"))
print(file_remove("_dlc_fs_folders/b.txt"), file_remove("_dlc_fs_folders/ä.txt"))
print(file_removedir("_dlc_fs_folders"), file_isdir("_dlc_fs_folders"))
print(file_remove("_dlc_fs_plain.txt"))
