note: a comment runs to the end of the line.
note:
    A block comment
    runs until the word below.
endnote
use DLC:string
use DLC:list
use DLC:map
print("after comments")

note: numbers, strings and f-strings
number a = 42
number b = 3.25
str double = "say \"hi\""
str single = 'it\'s'
str escapes = "tab:\tend\\"
print(a, b, double, single)
print(escapes)
str two_lines = "first
second"
print(two_lines)
print(length(two_lines))
print(f"{a} + {b} = {a + b}")
print(f"braces: {{a}} and {{{a}}}")
print(f"{double.length()} chars")

note: a list or a map may end with a comma and may break across lines
list items = [
    1,
    2,
    3,
]
map ages = {
    "ann": 31,
    "bo": 27,
}
print(items, length(items))
print(ages, length(ages))
print(join_all(
    "a",
    "b"
))

func join_all(any x, any y) do:
    return x + y
end

note: every type can be written as a declaration
empty nothing = empty
any thing = empty
match found = match("a1", p"[num]")
pattern digits = p"[num]+"
boolean ok = true
print(nothing, thing, found, ok, type_of(digits))

note: a body may sit on the header's line
if a is 42 do: print("one-line if") end
loop repeat number i = 1 ~ 3 do: print(i) end
func twice(any x) do: return x * 2 end
print(twice(4))
class Marker do: end
print(Marker() isa Marker)
