use DLC:math

note: floored modulo takes the sign of the divisor
print(math_mod(7, 3))
print(math_mod(-7, 3))
print(math_mod(7, -3))
print(math_mod(5.5, 2))

print(math_clamp(15, 0, 10))
print(math_clamp(-5, 0, 10))
print(math_clamp(5, 0, 10))

print(math_sign(-8))
print(math_sign(0))
print(math_sign(3.5))

print(math_trunc(-2.7))
print(math_trunc(2.7))
print(math_round(3.14159, 2))
print(math_round(2.5))
print(math_round(-2.5))

print(math_log2(8))
print(math_log10(1000))
print(math_log(8, 2))
print(math_exp(0))
print(math_round(math_atan2(1, 1) * 4, 10))
print(math_round(math_sin(math_pi() / 2), 10))
print(math_round(math_cos(0), 10))

note: min/max take separate numbers or one list
print(math_min(3, 1, 2))
print(math_max([4, 9, 2]))
print(math_min([5]))

print(math_pow(2, 10))
print(math_pow(2, -1))
