note: loop each walks a list, a map's keys or a str's characters; skip goes to the next round.
loop each number n in [10, 20, 30] do:
    print(n)
end

map ages = {"Ann": 31, "Bob": 25, "Cy": 40}
loop each str name in ages do:
    print(name, ages[name])
end

loop each str ch in "héllo" do:
    print(ch)
end

loop each any x in [] do:
    print("never")
end
loop each any x in {} do:
    print("never")
end
loop each str x in "" do:
    print("never")
end

loop each number n in [1, 2, 3, 4, 5, 6] do:
    if n % 2 is 0 do:
        skip
    end
    if n > 4 do:
        stop
    end
    print("odd", n)
end

note: skip and stop belong to the nearest loop
loop each list row in [[1, 2, 3], [4, 5, 6]] do:
    loop each any v in row do:
        if v is 2 do:
            skip
        end
        if v is 5 do:
            stop
        end
        print(v)
    end
end

note: the loop sees the collection as it was when it started
list items = [1, 2, 3]
loop each number i in items do:
    add i * 10 to items
end
print(items)

number round = 0
loop while round < 5 do:
    round = round + 1
    if round is 2 do:
        skip
    end
    print("round", round)
end

loop repeat number i = 1 ~ 6 do:
    if i % 3 is 0 do:
        skip
    end
    print("i", i)
end
loop repeat number i = 3 ~ 1 do:
    print("down", i)
end
