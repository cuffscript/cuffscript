note: a module is an ordinary program; what it declares becomes available to the program that uses it.
use inner from ./fixtures

constant str GREETING = "hello"

func shout(any word) do:
    return word.upper() + "!"
end

class Counter do:
    number count = 0
    func bump() do:
        self.count = self.count + 1
        return self.count
    end
end

print("helpers loaded")
