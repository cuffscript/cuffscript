note: async methods run later, in order, with their object; await runs one now.
class Worker do:
    str name = "w"
    list log = []

    func init(str name) do:
        self.name = name
    end

    async func job(number n) do:
        add n to self.log
        print(f"{self.name} job {n}")
    end

    async func total() do:
        number sum = 0
        loop each any n in self.log do:
            sum = sum + n
        end
        return sum
    end
end

Worker a = Worker("A")
Worker b = Worker("B")
a.job(1)
b.job(10)
a.job(2)
print("queued")
number t = await a.total()
print(t)
print(a.log, b.log)
