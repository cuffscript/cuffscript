note: classes are hoisted; defaults run for every new object; chaining; objects in collections.
number made = 0
func next_label() do:
    global made
    made = made + 1
    return f"obj-{made}"
end

Point origin = Point(0, 0)
print(origin.dist2(Point(3, 4)))

class Point do:
    number x = 0
    number y = 0
    str label = next_label()

    func init(number x, number y) do:
        self.x = x
        self.y = y
    end

    func dist2(Point other) do:
        return (self.x - other.x) ** 2 + (self.y - other.y) ** 2
    end

    func plus(Point other) do:
        return Point(self.x + other.x, self.y + other.y)
    end

    func to_str() do:
        return f"({self.x}, {self.y})"
    end
end

Point a = Point(1, 2)
Point b = Point(10, 20)
print(a.label, b.label, origin.label)
print(a.plus(b).plus(a))
print(a.plus(b).x)
print(f"sum is {a.plus(b)}")

note: identity in collections
list points = [a, b]
use DLC:list
print(contains(points, a), contains(points, Point(1, 2)), index_of(points, b))
map by_name = {"a": a}
print(by_name["a"] is a, by_name["a"] is b)

note: reference semantics through functions
func nudge(Point p) do:
    p.x = p.x + 100
end
nudge(a)
print(a)

note: objects are truthy, empty is not
any none = empty
if a do:
    print("an object is true")
end
if !none do:
    print("empty is false")
end
print(none is empty, a is empty)

note: recursion through methods
class Tree do:
    number value = 0
    list kids = []

    func init(number value) do:
        self.value = value
    end

    func add_kid(Tree kid) do:
        add kid to self.kids
        return kid
    end

    func total() do:
        number sum = self.value
        loop each any kid in self.kids do:
            sum = sum + kid.total()
        end
        return sum
    end

    func depth() do:
        number best = 0
        loop each any kid in self.kids do:
            number d = kid.depth()
            if d > best do:
                best = d
            end
        end
        return best + 1
    end
end
Tree root = Tree(1)
Tree child = root.add_kid(Tree(2))
child.add_kid(Tree(3))
root.add_kid(Tree(4))
print(root.total(), root.depth(), child.depth())

constant Point FIXED = Point(5, 5)
print(FIXED)
