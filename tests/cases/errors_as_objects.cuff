note: fail raises an Error; or_else as binds it; engine errors arrive as the same Error.
class ValidationError extends Error do:
    set str field to ""

    func init(str message, str field to "") do:
        super.init(message)
        change self.field to field
    end
end

class NotFound extends Error do:
end

func check_age(age) do:
    if age < 0 do:
        fail ValidationError("age cannot be negative", "age")
    end
    if age > 150 do:
        fail "age is too large"
    end
    return age
end

func try_age(age) do:
    check_age(age) or_else as err do:
        if err isa ValidationError do:
            print(f"invalid {err.field}: {err.message}")
        else if err isa Error do:
            print(f"error {err.code}: {err.message}")
        end
    end
end
try_age(10)
try_age(-5)
try_age(200)

note: the fields of an Error
set Error plain to Error("custom text")
print(plain.message, plain.code, plain.line, plain.column, plain.hint is "")
print(plain)
print(plain isa Error, type_of(plain))

note: engine errors are Errors too
print(1 / 0) or_else as e do:
    print(e.code)
    print(e.message)
    print(e.line, e.column)
    print(e isa Error)
end

use DLC:list
set list items to [1, 2]
print(items[5]) or_else as e do:
    print(e.code, e.message)
end

note: an or_else without a name still works
print(1 / 0) or_else do:
    print("caught")
end

note: rethrow, and branch by class
func outer() do:
    try_inner() or_else as err do:
        print("outer saw:", err.message)
        fail NotFound("wrapped: " + err.message)
    end
end
func try_inner() do:
    fail "inner problem"
end
outer() or_else as err do:
    print(type_of(err), err isa NotFound, err isa ValidationError)
    print(err)
end

note: fail err keeps an engine error unchanged
func divide(a, b) do:
    return a / b
end
divide(1, 0) or_else as err do:
    print("first", err.code)
    divide(1, 0) or_else as inner do:
        print("again", inner.code)
    end
end

set Error made to NotFound("lookup failed")
print(made.code, made.message)
print(made)

note: an Error raised with fail knows where it was raised
func boom() do:
    fail "located"
end
boom() or_else as e do:
    print(e.line, e.column, e.message)
end
