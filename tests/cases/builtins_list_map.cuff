use DLC:list
use DLC:map

print(sum([1, 2, 3, 4]))
print(average([1, 2, 3, 4]))
print(flatten([1, [2, 3], [4], 5]))

print(range(1, 5))
print(range(5, 1))
print(range(0, 10, 5))
print(range(0, 1, 0.25))
print(range(5, 1, 1))

print(unique([3, 1, 3, 2, 1]))
print(unique(["b", "a", "b"]))
print(unique([[1], [1], [2]]))

print(sort([3, 1, 2]))
print(sort(["b", "a", "c"]))
print(reverse([1, 2, 3]))
print(join(["a", "b"], "-"))

set map m to {"x": 1, "y": 2}
print(keys(m))
print(values(m))
print(has_key(m, "x"))
print(has_key(m, "z"))
print(entries(m))
print(merge(m, {"y": 20, "z": 30}))
print(m)
print(length(m))
