use DLC:list
use DLC:map

print(list_sum([1, 2, 3, 4]))
print(list_average([1, 2, 3, 4]))
print(list_flatten([1, [2, 3], [4], 5]))

print(list_range(1, 5))
print(list_range(5, 1))
print(list_range(0, 10, 5))
print(list_range(0, 1, 0.25))
print(list_range(5, 1, 1))

print(list_unique([3, 1, 3, 2, 1]))
print(list_unique(["b", "a", "b"]))
print(list_unique([[1], [1], [2]]))

print(list_sort([3, 1, 2]))
print(list_sort(["b", "a", "c"]))
print(list_reverse([1, 2, 3]))
print(list_join(["a", "b"], "-"))

set map m to {"x": 1, "y": 2}
print(map_keys(m))
print(map_values(m))
print(map_has_key(m, "x"))
print(map_has_key(m, "z"))
print(map_entries(m))
print(map_merge(m, {"y": 20, "z": 30}))
print(m)
print(length(m))
