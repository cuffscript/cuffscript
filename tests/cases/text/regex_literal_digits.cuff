note: a digit run is a repeat count only after a token, set or group; after a literal
note: character or an anchor it is ordinary text.
str phone = "010-1234-5678"
print(phone matches p"010-[num]4-[num]4")
print("0000000000-1234-5678" matches p"010-[num]4-[num]4")
print("2026-12-25" is "2026-12-25")
print("v2" is "v2")
print("vv" is "v2")
print("2026 report" matches p"[start]2026[sp]report")
print("ABABAB" matches p"(AB)3")
print("2026" matches p"[num]4")
print(find("call 010-1234 now", p"[one:010]-[num]4"))
print(replace(phone, p"010-[num]4-", "010-****-"))
