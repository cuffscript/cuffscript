note: what an f-string and print write for numbers, booleans and empty, and for values that are made text first.
number big = 10 ** 308 * 10
number nan = big - big
str s = "s"
print(f"{1}|{-0}|{0.1}|{1/3}|{1e20}|{-1e300}|{2**53}|{true}|{false}|{empty}|{[1, 2]}|{nan}|{big}|{0 - big}")
print(f"x{s}y|{123456789012345}|{1234567890123456}|{-999999999999999}|{-0.5}|{99}|{100}|{-10}")
print(f"{1}", f"a{2}b{3}c", f"{{}}")
print(0, -0, 9, 10, 99, 100, 999999999999999, 1e15, 7.5, true, empty, [1, "b"], {"k": 2}, "end")
print()
class Shown do:
    func to_str() do:
        return "shown"
    end
end
print(f"<{Shown()}>", Shown(), [Shown()])
