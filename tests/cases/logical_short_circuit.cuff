set returnable func say(text, value) do:
    print(text)
    return value
end
print(say("left", false) and say("right", true))
print(say("left", true) and say("right", true))
print(say("left", true) or say("right", false))
print(say("left", false) or say("right", true))
print(say("a", true) or say("b", true) or say("c", true))
print(say("a", false) and say("b", true) and say("c", true))
print(say("a", true) and say("b", false) or say("c", true))
print(false and 1 / 0 is 1)
print(true or 1 / 0 is 1)
print(false and not_defined_anywhere)
print(true || not_defined_anywhere)
