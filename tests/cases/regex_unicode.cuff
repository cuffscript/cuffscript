note: [any] counts codepoints, not bytes
print("안녕하세요" matches p"[any]5")
print("안녕하세요" matches p"[any]15")

note: literal multi-byte characters in a pattern
print("안녕" is "안녕")

note: a negated set matches a non-ASCII codepoint
print("안" matches p"[!num]")

note: [one:...] with multi-byte alternatives
print("사과" matches p"[one:사과|배]")

note: mixed ASCII + multi-byte
print("Hi안녕" matches p"[let]2[any]2")

note: named capture spanning multi-byte text
set match m to match("이름: 홍길동", p"이름: <name:[any]+>")
print(m["name"])

note: per spec, [let]/[str]/[word] are English-only (ASCII letters)
print("안녕" matches p"[let]+")

note: [edge] treats non-ASCII letters as word characters (spec 17)
print(find_all("안녕 하세요", p"[edge]안녕[edge]"))
print(find_all("the cat sat, category", p"[edge]cat[edge]"))

note: find/replace/split/count over multi-byte text
print(count("가나다라마", p"[any]"))
print(find_all("가나다", p"[any]"))
print(replace("가나다", p"나", "X"))
print(split("사과,배,포도", p","))
print(replace_all("비밀", p"[any]", "*"))
