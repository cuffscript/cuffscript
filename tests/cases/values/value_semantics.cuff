note: circular structures print with a marker and compare by shape
list a = [1]
add a to a
print(a)

list b = [1]
add b to b
print(a is b)

map d = {"k": 1}
d["self"] = d
print(d)

note: nested structures compare deeply, however deep
list x = []
list z = []
loop repeat number i = 1 ~ 3000 do:
    list y = [x]
    x = y
    list w = [z]
    z = w
end
print(x is z)
add z to z
print(x is z)

note: strings are values — copies never affect each other
str original = "abc"
str copy = original
copy = copy + "d"
print(original)
print(copy)
