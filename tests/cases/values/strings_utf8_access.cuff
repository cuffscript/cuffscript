use DLC:string

str s = "a한b🙂c"
print(length(s))

note: forward, backward and negative access must agree (cursor caching)
loop repeat number i = 1 ~ 5 do:
    print(s[i])
end
loop repeat number i = 5 ~ 1 do:
    print(s[i])
end
print(s[-1])
print(s[-2])
print(s[2~4])
print(s[4~4])
print(s[1~5])

str plain = "hello"
print(plain[2])
print(plain[2~4])
print(plain[-3~-1])
