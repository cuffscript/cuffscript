note: a loop and an if do not open a scope; a function does
loop repeat number i = 1 ~ 3 do:
    number last = i * 10
end
print(i, last)

if true do:
    number inside = 7
end
print(inside)

func work() do:
    number hidden = 1
    return hidden
end
print(work())
print(hidden) or_else as Error problem do:
    print(problem.code, "a function's variables stay inside it")
end
