class Parent do:
    private number secret = 7

    func reveal() do:
        return self.secret
    end
end

class Child extends Parent do:
    func peek() do:
        return self.secret
    end
end

Child kid = Child()
print(kid.reveal())
print(kid.peek()) or_else as Error problem do:
    print(problem.code, "a child inherits the field but not the right to read it")
end
