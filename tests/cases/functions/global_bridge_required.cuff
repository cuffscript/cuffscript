note: A function sees only its own locals plus the globals it bridges with `global x`.

number total = 10
constant number LIMIT = 3
list items = [1, 2]

func unbridged_read() do:
    print(total)
end

func unbridged_write() do:
    total = 99
end

func unbridged_add() do:
    add 3 to items
end

func bridged() do:
    global total
    global LIMIT
    global items
    total = total + LIMIT
    add 3 to items
end

func local_shadow() do:
    number total = 1
    total = total + 1
    print(f"local total = {total}")
end

unbridged_read() or_else do:
    print("read blocked")
end
unbridged_write() or_else do:
    print("write blocked")
end
unbridged_add() or_else do:
    print("add blocked")
end
print(f"total after blocked calls = {total}")

bridged()
print(f"total after bridged call = {total}")
print(f"items after bridged call = {items}")

local_shadow()
print(f"total after local shadow = {total}")
