note: when a queued async job queues another async job from inside itself,
note: that job must also run, in queue order, during the same drain.

async func level_c() do:
    print("C ran")
end
async func level_b() do:
    print("B ran")
    level_c()
end
async func level_a() do:
    print("A ran")
    level_b()
end

print("sync start")
level_a()
print("sync end")
