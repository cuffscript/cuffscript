note: every parameter is written `type name`; `any` takes a value of any type.
func add_num(number n1, number n2) do:
    return n1 + n2
end
print(add_num(1, 2))

use DLC:list
func greet(str name, any count, list items) do:
    print(f"{name} {count} {length(items)}")
end
greet("kim", 3, [1, 2])

func mixed(any a, number b) do:
    return a + b
end
print(mixed(5, 6))

note: `empty` is a value of its own type: only `empty` and `any` take it
func maybe(any s) do:
    return s is empty
end
print(maybe(empty))

note: map / boolean / match types
func show(map m, boolean flag) do:
    print(f"{length(m)} {flag}")
end
show({"a": 1}, true)

note: async functions are also type-checked at call time
async func later(number n) do:
    print(f"later {n}")
end
later(7)
print("sync done")
