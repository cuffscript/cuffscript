note: an async call without await starts a task and gives a Task; await gives the task's result
async func double(number n) do:
    print(f"double({n}) runs")
    return n * 2
end

Task t = double(4)
print(type_of(t), t, t.done(), task_done(t))
print("the task has not run yet")
number result = await t
print(result, t.done())
print(await t)

note: await in front of a call still runs the call there and then
print(await double(5))

note: tasks start in the order they were made, when the code that made them waits
list tasks = [double(1), double(2), double(3)]
print("three tasks made")
number sum = 0
loop each Task each_task in tasks do:
    sum = sum + await each_task
end
print(sum)

note: a task is a value like any other
map by_name = {"six": double(6)}
Task same = by_name["six"]
Task duplicate = copy(same)
print(await same, await duplicate, await by_name["six"], same.done(), duplicate.done())

note: a call that is a statement of its own gives no Task; it runs when the program waits or ends
double(7)
print("end of the program's own lines")
