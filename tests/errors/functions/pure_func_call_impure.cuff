note: E4-029
number counter = 0

func bump() do:
    global counter
    counter = counter + 1
end

pure func trigger_bump() do:
    note: a pure function can no longer call a user function that is not pure --
    note: previously this call was allowed, so a plain helper function could be used
    note: to get around pure's global-access block.
    bump()
    return 1
end
print(trigger_bump())
