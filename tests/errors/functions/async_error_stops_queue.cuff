note: E4-001 -- if one queued job throws, the remaining jobs must not run,
note: exactly as when an error occurs partway through synchronous code.
async func task_a() do:
    print("A ran")
end
async func task_b() do:
    undeclared_var = 5
end
async func task_c() do:
    print("C ran (should not happen)")
end
task_a()
task_b()
task_c()
